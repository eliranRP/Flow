{
  "name": "@flow/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 43123 --strictPort",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "storybook": "storybook dev -p 6006 --host 0.0.0.0",
    "build-storybook": "storybook build",
    "test:storybook": "vitest run --project storybook --project storybook-dark",
    "test:storybook:smoke": "playwright test -c playwright.storybook.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:live": "playwright test -c playwright.live.config.ts",
    "test:e2e:smoke": "playwright test -c playwright.smoke.config.ts",
    "test:perf": "playwright test -c playwright.perf.config.ts",
    "preview": "vite preview --host 0.0.0.0 --port 43123 --strictPort"
  },
  "dependencies": {
    "@flow/shared": "workspace:*",
    "@fontsource/rubik": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "vaul": "1.1.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "10.6.6",
    "@storybook/addon-docs": "10.6.6",
    "@storybook/addon-vitest": "10.6.6",
    "@storybook/react-vite": "10.6.6",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "jsdom": "^30.1.3",
    "playwright": "1.65.0",
    "storybook": "10.6.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
