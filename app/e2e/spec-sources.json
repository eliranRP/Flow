{
  "about": "FLOW-813: which app sources each e2e spec exercises, for the pre-push gate (scripts/e2e-specs.mjs). Entries are under app/src; one ending in / takes every source in that folder. A spec runs when it, a file it imports, or anything its entries import (followed through relative imports, the screens barrel by name, and @flow/shared) changed. A change matching an `all` pattern, or to an app source that only App.tsx reaches (the session providers), runs every spec. Migrations and edge functions pick no spec here: the specs that use local Supabase run on main. `ignored` specs run on their own configs.",
  "all": [
    "^app/src/(App|main|dev-routes)\\.tsx$",
    "^app/src/screens/flow-screens\\.tsx$",
    "^app/src/.*\\.css$",
    "^design/system/.*\\.css$",
    "^app/(index\\.html|vite\\.config\\.ts|playwright\\.config\\.ts|package\\.json|tsconfig[^/]*\\.json)$",
    "^app/e2e/spec-sources\\.json$",
    "^scripts/(e2e-specs\\.mjs|hosted-env\\.mjs)$",
    "^pnpm-lock\\.yaml$"
  ],
  "ignored": [
    "smoke-readonly.spec.ts",
    "storybook-clip.spec.ts",
    "storybook-layout.spec.ts",
    "storybook-secret.spec.ts",
    "storybook-static.spec.ts",
    "sumit-drain.spec.ts",
    "sumit-live.spec.ts"
  ],
