@@ -0,0 +1,85 @@
+import { fireEvent, render, screen } from "@testing-library/react";
+import { MemoryRouter } from "react-router-dom";
+import { describe, expect, it } from "vitest";
+import { CompactBar } from "./compact-bar";
+import { expectRtl } from "./test-support";
+
+function bar(props: Partial<Parameters<typeof CompactBar>[0]> & { shown: boolean }) {
+  return (
+    <MemoryRouter>
+      <CompactBar title="שויכו היום" backTo="/review" {...props} />
+    </MemoryRouter>
+  );
+}
+
+describe("CompactBar", () => {
+  it("slides in with m-bar-in when shown, and is in the reader's tree", () => {
+    expectRtl();
+    const { container } = render(bar({ shown: true }));
+    const root = container.querySelector(".ui-compact-bar");
+    expect(root).toHaveClass("m-bar-in");
+    expect(root).not.toHaveClass("m-bar-out");
+    expect(root).not.toHaveAttribute("inert");
+    expect(root).toHaveAttribute("aria-hidden", "false");
+  });
+
+  it("slides out with m-bar-out, then leaves the focus order once the animation ends", () => {
+    const { container, rerender } = render(bar({ shown: true }));
+    rerender(bar({ shown: false }));
+    const root = container.querySelector(".ui-compact-bar") as HTMLElement;
+    expect(root).toHaveClass("m-bar-out");
+    expect(root).toHaveAttribute("aria-hidden", "true");
+    expect(root).toHaveAttribute("inert");
+    expect(root).not.toHaveClass("ui-compact-bar-gone");
+    fireEvent.animationEnd(root);
+    expect(root).toHaveClass("ui-compact-bar-gone");
+    expect(root).not.toHaveClass("m-bar-out");
+    expect(screen.queryByRole("button", { name: "חזרה" })).toBeNull();
+  });
+
+  it("starts hidden without a slide, so a page that has not scrolled shows no bar", () => {
+    const { container } = render(bar({ shown: false }));
+    const root = container.querySelector(".ui-compact-bar");
+    expect(root).toHaveClass("ui-compact-bar-gone");
+    expect(root).not.toHaveClass("m-bar-out");
+    expect(root).not.toHaveClass("m-bar-in");
+    expect(root).toHaveAttribute("aria-hidden", "true");
+    expect(root).toHaveAttribute("inert");
+  });
+
+  it("comes back in on a second show, with the same state as the first", () => {
+    const { container, rerender } = render(bar({ shown: false }));
+    rerender(bar({ shown: true }));
+    const root = container.querySelector(".ui-compact-bar");
+    expect(root).toHaveClass("m-bar-in");
+    expect(root).not.toHaveClass("ui-compact-bar-gone");
+    expect(root).not.toHaveAttribute("inert");
+  });
+
+  it("puts the figure after the title inside an LTR bdi", () => {
+    const { container } = render(bar({ shown: true, figure: <span>1,250</span> }));
+    const figure = container.querySelector(".ui-compact-title bdi");
+    expect(figure).toHaveAttribute("dir", "ltr");
+    expect(figure).toHaveTextContent("1,250");
+    expect(container.querySelector(".ui-compact-title")).toHaveTextContent("שויכו היום · 1,250");
+  });
+
+  it("names the labelled Back after its label, and keeps the icon Back without one", () => {
+    const { rerender } = render(bar({ shown: true, label: "הגדרות" }));
+    expect(screen.getByRole("button", { name: "חזרה להגדרות" })).toHaveTextContent("הגדרות");
+    rerender(bar({ shown: true }));
+    expect(screen.getByRole("button", { name: "חזרה" })).toBeInTheDocument();
+  });
+
+  it("has no Back when there is no place to go back to", () => {
+    const { container } = render(bar({ shown: true, backTo: undefined }));
+    expect(container.querySelector(".ui-compact-bar button")).toBeNull();
+  });
+
+  it("is 44px on a list page and 56px on a detail page", () => {
+    const { container, rerender } = render(bar({ shown: true }));
+    expect(container.querySelector(".ui-compact-bar")).toHaveClass("ui-compact-bar-list");
+    rerender(bar({ shown: true, size: "detail" }));
+    expect(container.querySelector(".ui-compact-bar")).toHaveClass("ui-compact-bar-detail");
+  });
+});
diff --git a/app/src/ui/compact-bar.tsx b/app/src/ui/compact-bar.tsx
new file mode 100644
index 00000000..23f3eb9d
--- /dev/null
+++ b/app/src/ui/compact-bar.tsx
@@ -0,0 +1,120 @@
+import { useEffect, useRef, useState, type ReactNode } from "react";
+import { useBackLandsOn, useGoBack } from "./back";
+import { IconButton } from "./icon-button";
+import { BackIcon } from "./icons";
+
+export type CompactBarSize = "list" | "detail";
+
+export type CompactBarProps = {
+  title: string;
+  /** After the title, " · " and the figure (an Amount at list size). Its own LTR run. */
+  figure?: ReactNode;
+  /** Back's label, the parent's name (decision 0156). Without one, Back is the icon. */
+  label?: string;
+  /** Where Back goes. Without it the bar has no Back. */
+  backTo?: string;
+  /** 44px on a list page, 56px on a detail page. */
+  size?: CompactBarSize;
+  /** Slides in (m-bar-in) or out (m-bar-out). A hidden bar takes no focus or clicks. */
+  shown: boolean;
+  /** At the end of the bar. */
+  actions?: ReactNode;
+};
+
+/**
+ * Bars showing, by size. The html element reports the bar it has under it: the page's sticky month
+ * heads and scroll padding use the height of the bar (27-compact-header.css).
+ */
+const showing: Record<CompactBarSize, number> = { list: 0, detail: 0 };
+
+function reportShowing(size: CompactBarSize, delta: number): void {
+  showing[size] = Math.max(0, showing[size] + delta);
+  const root = document.documentElement;
+  const total = showing.list + showing.detail;
+  if (total === 0) root.removeAttribute("data-compact-bar");
+  else root.setAttribute("data-compact-bar", showing.detail > 0 ? "detail" : "list");
+}
+
+/**
+ * The one compact bar (decision 0156 extended, FLOW-363 3a): Back on the start side, the title
+ * centred in one line, an optional figure after it, actions at the end. It stays mounted once a
+ * page can show it, so the slide out has something to run on; `shown` drives the classes.
+ */
+export function CompactBar({ title, figure, label, backTo, size = "list", shown, actions }: CompactBarProps) {
+  const goBack = useGoBack();
+  const landsOnLabel = useBackLandsOn(backTo ?? "/");
+  // `gone` is true once a hidden bar's slide out has ended (or it never showed): visibility hidden.
+  const [prevShown, setPrevShown] = useState(shown);
+  const [gone, setGone] = useState(!shown);
+  if (shown !== prevShown) {
+    setPrevShown(shown);
+    if (shown) setGone(false);
+  }
+
+  useEffect(() => {
+    if (!shown) return;
+    reportShowing(size, 1);
+    return () => {
+      reportShowing(size, -1);
+    };
+  }, [shown, size]);
+
+  // The slide out ends the hiding: the bar is visibility hidden from then on. A native listener, the
+  // way the sheet listens for its own slide (sheet.tsx).
+  const root = useRef<HTMLDivElement>(null);
+  useEffect(() => {
+    const node = root.current;
+    if (shown || node == null) return;
+    const onEnd = (event: AnimationEvent) => {
+      if (event.target === node) setGone(true);
+    };
+    node.addEventListener("animationend", onEnd);
+    return () => {
+      node.removeEventListener("animationend", onEnd);
+    };
+  }, [shown]);
+
+  const state = shown ? "m-bar-in" : gone ? "ui-compact-bar-gone" : "m-bar-out";
+  const labelled = label != null && label !== "" && landsOnLabel;
+  let back: ReactNode = null;
+  if (backTo != null) {
+    back = labelled ? (
+      <button
+        type="button"
+        className="ui-back-labelled"
+        aria-label={`חזרה ל${label}`}
+        onClick={() => { goBack(backTo); }}
+      >
+        <BackIcon />
+        <span className="ui-back-text">{label}</span>
+      </button>
+    ) : (
+      <IconButton label="חזרה" onClick={() => { goBack(backTo); }}>
+        <BackIcon />
+      </IconButton>
+    );
+  }
+  return (
+    <div
+      ref={root}
+      className={`ui-compact-bar ui-compact-bar-${size} ${state}`}
+      aria-hidden={!shown}
+      inert={shown ? undefined : true}
+    >
+      <div className="ui-compact-bar-row">
+        {back}
+        {/* The page's h1 is still there; this is its echo. */}
+        <span className="ui-compact-title t-btn" aria-hidden="true">
+          {title}
+          {figure != null ? (
+            <>
+              {" · "}
+              <bdi dir="ltr">{figure}</bdi>
+            </>
+          ) : null}
+        </span>
+        {actions != null ? <div className="ui-compact-actions">{actions}</div> : null}
+      </div>
+    </div>
+  );
+}
