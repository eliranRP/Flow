# Flow local environment. Copy to .env and fill in. Never commit .env.
# Hosted project (Supabase Free, eu-central-1, Postgres 17):
#   ref  sxqpnetmtufkzowutduq
#   url  https://sxqpnetmtufkzowutduq.supabase.co
# Keys stay in the Supabase dashboard. Do not paste the service role key here
# if this file might be shared; .env is gitignored.

# Publishable client settings (Vite exposes only VITE_* to the browser).
VITE_SUPABASE_URL=https://sxqpnetmtufkzowutduq.supabase.co
VITE_SUPABASE_ANON_KEY=

# Server-side only. Required by `pnpm seed:demo` and `pnpm latency`.
# SUPABASE_SERVICE_ROLE_KEY bypasses RLS. It must never ship in the PWA.
SUPABASE_URL=https://sxqpnetmtufkzowutduq.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# auth.users id of the Google account that should own the demo company.
SEED_OWNER_USER_ID=

# Optional. A user access token (not the service role) so `pnpm latency`
# can call get_home() as that user. Without it the script still times the
# round trip and records the HTTP status.
SUPABASE_ACCESS_TOKEN=

# Local Supabase Auth, when you run `supabase start`. Leave empty until the
# Google OAuth client exists. The hosted provider is configured in the
# dashboard, not in this file.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
